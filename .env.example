# NEXTWIN — production env vars
# Copy to .env.local for local dev, or paste into Vercel project env settings.

# -----------------------------------------------------------------------------
# Database — Supabase Postgres
# -----------------------------------------------------------------------------
# Runtime queries go through the Transaction pooler (port 6543, pgbouncer).
# Required `pgbouncer=true` so Prisma disables prepared statements that
# pgbouncer can't proxy. `connection_limit=1` is the recommended default
# for serverless (Vercel) — each function instance gets one upstream conn.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# `prisma migrate` cannot run through pgbouncer (it needs prepared
# statements for transactional DDL). DIRECT_URL points at the session
# pooler on port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase Storage — admin uploads
# -----------------------------------------------------------------------------
# Public URL of the project (used both client-side and server-side).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Service-role key — server-only. NEVER ship to the browser. Bypasses RLS.
# Used by /api/admin/upload* to write into the storage bucket.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional — bucket name. Defaults to "uploads".
SUPABASE_STORAGE_BUCKET="uploads"

# -----------------------------------------------------------------------------
# Admin auth
# -----------------------------------------------------------------------------
# Long random string. Used to sign the JWT in admin session cookies.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=""

# Admin login password. Plain text is fine for dev; for prod, generate a
# bcrypt hash (`npx -p bcryptjs -e 'console.log(require("bcryptjs").hashSync("your-password", 10))'`)
# and put it in ADMIN_PASSWORD_HASH instead. Either ADMIN_PASSWORD or
# ADMIN_PASSWORD_HASH must be set.
ADMIN_PASSWORD=""
# ADMIN_PASSWORD_HASH=""

# -----------------------------------------------------------------------------
# App config
# -----------------------------------------------------------------------------
# Public canonical URL — used for absolute links in emails, OG tags, etc.
NEXT_PUBLIC_SITE_URL="https://nextwin.ma"

# -----------------------------------------------------------------------------
# Cloudflare R2 — hero videos + property photos
# -----------------------------------------------------------------------------
# Set all 5 of these on the host (Vercel / Netlify / Cloudflare Pages env
# vars). Local dev can either set them in .env or keep using
# .deploy/r2-secrets.txt (env wins if both exist).
# Cloudflare dashboard → R2 → Manage R2 API Tokens → "Create API Token"
# with "Object Read & Write" scope on the bucket. Endpoint + public URL
# live under the bucket's "Settings" tab.
R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="nextwin-media"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
