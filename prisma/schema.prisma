// NEXTWIN admin panel data model.
// Postgres in production (Supabase). DATABASE_URL points at the Transaction
// pooler (port 6543, pgbouncer) for runtime; DIRECT_URL points at the
// session pooler (port 5432) for `prisma migrate`, which can't run through
// pgbouncer. Multilingual fields (FR / EN / AR) are stored as separate
// string columns so the public site can read them without parsing JSON,
// and the admin can edit each language in its own input.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Property {
  id            String   @id @default(cuid())
  slug          String   @unique
  type          String   // "riad" | "villa" | "apartment" | "terrain" | "commercial"
  area          String
  city          String   @default("Marrakech")
  rating        Float    @default(4.85)
  reviewCount   Int      @default(0)
  guests        Int
  bedrooms      Int
  bathrooms     Int

  // Listing kind — determines which price field is canonical and which
  // public flow (booking calendar vs. inquiry) is used.
  //   "SHORT_STAY"  : nightly rental, uses pricePerNight + Reservation
  //   "RENT_LONG"   : monthly long-term lease, uses monthlyRent + inquiry
  //   "SALE"        : property for sale, uses salePrice + inquiry
  listingKind   String   @default("SHORT_STAY")

  pricePerNight Int      @default(0)   // SHORT_STAY: nightly rate, minor units
  monthlyRent   Int?                   // RENT_LONG: monthly rent, minor units
  salePrice     Int?                   // SALE: total sale price, minor units
  surfaceM2     Int?                   // "Surface habitable" - built/living area (m²)

  currency      String   @default("EUR")  // "EUR" | "MAD"

  // -------------- Real-estate structured fields --------------
  // Mostly used by SALE + RENT_LONG; optional for SHORT_STAY.
  // Modelled after the structured field set surfaced by Mubawab.ma
  // and Avito.ma so Moroccan buyers/renters see what they expect.
  landSurfaceM2     Int?      // "Surface terrain" - land/plot (villas, terrains)
  floor             Int?      // "Étage du bien" (apartments, bureaux, magasins)
  totalFloors       Int?      // Total floors in the building (apartments)
  yearBuilt         Int?      // Année de construction
  condition         String?   // "Neuf" | "Bon état" | "À rénover" | "Jamais habité"
  standing          String?   // "Haut standing" | "Standing moyen" | "Économique"
  orientation       String?   // "Nord" | "Sud" | "Est" | "Ouest" | "Sud-Est" etc.
  furnished         Boolean?  // Meublé / Non meublé
  parkingSpaces     Int?      // Number of parking spots included

  // Terrain-specific
  landStatus        String?   // "Titré" | "En cours de titrement" | "Réquisition" | "Non titré"
  landZoning        String?   // "Constructible R+1" | "Lot de villa" | "Agricole" etc.

  // Long-term rental specific (RENT_LONG)
  securityDeposit   Int?      // Caution, expressed in number of months
  monthlyCharges    Int?      // Charges syndic mensuelles, minor units
  agencyFeeMonths   Float?    // Frais d'agence, in months (typically 1)

  // Commercial-specific (bureau / magasin / plateau de bureaux)
  ceilingHeight     Float?    // Hauteur sous plafond (m)

  // Three universal fields Avito.ma surfaces on most categories.
  salons            Int?      // Nombre de salons (Moroccan listings split salons from chambres)
  apartmentSubtype  String?   // "Standard" | "Studio" | "Duplex" | "Triplex" | "Loft"
  availability      String?   // "Immédiate" | "2026-09" | etc.
  // ------------------------------------------------------------

  // Multilingual title + descriptions. FR is primary, EN/AR optional.
  titleFr            String
  titleEn            String?
  titleAr            String?
  shortDescriptionFr String?
  shortDescriptionEn String?
  shortDescriptionAr String?
  descriptionFr      String?
  descriptionEn      String?
  descriptionAr      String?

  // JSON-encoded string arrays (SQLite has no native array type).
  amenitiesJson  String @default("[]")
  highlightsJson String @default("[]")

  hostName  String  @default("NEXTWIN")
  hostYears Int     @default(1)

  // Approximate location (privacy-preserving). The public site renders a
  // ~200m radius zone circle instead of a pin. Null = map section hidden.
  latitude       Float?
  longitude      Float?
  locationRadius Int     @default(200) // metres

  // House rules — overridden by the admin per-property; defaults match
  // the global Settings values until then.
  ruleCheckIn       String  @default("À partir de 15h00")
  ruleCheckOut      String  @default("Avant 11h00")
  rulePets          String  @default("Sur demande")
  ruleSmoking       String  @default("Interdit à l'intérieur")
  ruleAdditional    String?

  // Minimum stay enforced by the calendar UI — date ranges shorter
  // than this are visually rejected (the second-pick highlights only
  // become selectable once `minNights` is reached). Default 1 keeps
  // shorter stays allowed for new rows; per-property overrides come
  // through the bulk import meta.json or the admin editor.
  minNights         Int     @default(1)

  images       PropertyImage[]
  reservations Reservation[]

  published Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Guest profile — auto-created when a reservation is captured. Email + phone
// are unique-ish but optional (some bookings only have a phone). The repo
// dedupes on (lower(email)) || phone before inserting.
model Client {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  nationality  String?
  language     String?
  vip          Boolean  @default(false)
  blocked      Boolean  @default(false)
  notes        String?
  totalSpend   Int      @default(0) // denormalised cents-as-int (EUR), recomputed on reservation events
  reservations Reservation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([phone])
}

// The booking ledger. status / source kept as strings for SQLite portability;
// the canonical enums live in src/lib/reservation-status.ts.
//
//   status: PENDING | CONFIRMED | CHECKED_IN | COMPLETED | CANCELLED | NO_SHOW
//   source: DIRECT | AIRBNB | BOOKING | EXPEDIA | OTHER
//
// Conflict guard: app-level in createReservation() — Postgres swap will add
// an EXCLUDE USING gist (propertyId, daterange(checkIn, checkOut, '[)')) for
// DB-level enforcement.
model Reservation {
  id        String @id @default(cuid())
  reference String @unique // human-readable: NW-2026-0143

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  status String @default("PENDING")
  source String @default("DIRECT")

  checkIn  DateTime
  checkOut DateTime
  nights   Int
  guests   Int    @default(2)

  nightlyRate Int
  cleaningFee Int    @default(0)
  serviceFee  Int    @default(0)
  total       Int
  currency    String @default("EUR")

  notes           String?
  specialRequests String?

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId, checkIn, checkOut])
  @@index([clientId])
  @@index([status])
  @@index([checkIn])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  src        String
  alt        String   @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// Single-row table for site-wide settings (hero copy, contact info, etc.).
// Always queried/upserted with id = 1.
model Settings {
  id Int @id @default(1)

  heroSubtitleFr String @default("Votre location de vacances à Marrakech.")
  heroSubtitleEn String @default("Your holiday rental in Marrakech.")
  heroSubtitleAr String @default("إيجارك للعطلات في مراكش.")

  // Editorial dateline shown beneath the hero wordmark — the small
  // all-caps line flanked by hairline rules. Stored per-locale so the
  // admin can localise it; an empty string in any slot hides the line
  // on that locale (so an FR-only label doesn't leak into EN / AR).
  heroTaglineFr String @default("Maisons de Marrakech")
  heroTaglineEn String @default("Houses of Marrakech")
  heroTaglineAr String @default("منازل مراكش")

  // Static fallback image — also serves as the <video poster> so the hero
  // paints instantly while the video frames stream in.
  heroImage String @default("https://images.unsplash.com/photo-1613490493576-7fde63acd811?auto=format&fit=crop&w=2400&q=80")

  // Optional hero videos — admin uploads two assets (landscape + portrait)
  // and the browser picks one via <source media> at first paint. Nullable
  // so the admin can clear them and revert to the static heroImage.
  heroVideoDesktop String?
  heroVideoMobile  String?

  // First-frame snapshots of each hero video, used as the <video poster>.
  // Because the poster is literally frame 0 of the same clip, the still
  // → motion handoff is invisible — no jarring scene change between the
  // placeholder and the video that replaces it. Auto-generated by
  // scripts/extract-hero-posters.mjs after each video upload.
  heroPosterDesktop String?
  heroPosterMobile  String?

  whatsappNumber String @default("+212600000000")
  email          String @default("hello@nextwin.stays")
  phone          String @default("+212524000000")
  addressLine    String @default("Gueliz, Marrakech 40000")

  footerBlurbFr String @default("Une sélection soignée de logements à Marrakech.")
  footerBlurbEn String @default("A curated selection of stays in Marrakech.")
  footerBlurbAr String @default("تشكيلة منتقاة من الإقامات في مراكش.")

  cleaningFee    Int @default(45)
  serviceFeeRate Float @default(0.07)

  // Manual home-featured picks. Each slug points to one published property
  // that the admin wants surfaced on the home page's three-card strip
  // (Court séjour, Long durée, Acheter). When NULL, the home page falls
  // back to its automatic pick (first match by kind).
  homeFeaturedShortStaySlug String?
  homeFeaturedRentLongSlug  String?
  homeFeaturedSaleSlug      String?

  updatedAt DateTime @updatedAt
}

// Cookie-based admin session. The cookie holds a signed JWT; the row tracks
// expiry/revocation server-side so logout is durable.
model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Per-page editorial content — Home / About / Contact body copy.
// One row per page, JSON blob keyed by field name with FR/EN/AR
// variants. Field names are defined in src/lib/page-content-schema.ts
// and shared between the admin editor and the public page that
// consumes them. Falls back to the i18n dictionary when a field is
// empty so the site is never blank.
model PageContent {
  id          Int      @id @default(autoincrement())
  pageKey     String   @unique  // "home" | "about" | "contact"
  contentJson String   @default("{}")
  updatedAt   DateTime @updatedAt
}

// User-submitted reviews — the public form on each property detail
// page inserts straight into this table via the Supabase anon client.
// `status` starts at "pending"; the admin queue at /admin/reviews
// flips it to "approved" or "denied". Only approved rows are mixed
// into the public reviews list; the submitting user also sees their
// own pending row via a localStorage-backed lookup.
//
// `categoryRatings` is JSON-encoded so we don't need a separate row
// per category. Shape:
//   { cleanliness: 5, accuracy: 5, checkin: 4, communication: 5,
//     location: 5, value: 5 }
model Review {
  id              String   @id @default(cuid())
  propertySlug    String
  author          String
  origin          String?
  body            String
  rating          Int      @default(5)
  categoryRatings String   @default("{}")
  authorImage     String?
  status          String   @default("pending") // pending | approved | denied
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertySlug, status])
  @@index([status])
}

// Property inquiry — lead captured from the public SALE / RENT_LONG
// detail-page form (the SHORT_STAY flow uses Reservation, not Inquiry).
// The admin queue at /admin/inquiries triages each one (Nouveau, Traité,
// Converti, Spam) and can convert to a Client + follow-up record.
model Inquiry {
  id             String   @id @default(cuid())
  propertySlug   String?  // null when sent from the generic /contact form
  propertyTitle  String?  // denormalised so the admin sees what the lead asked about even if the listing is later deleted
  kind           String   @default("SALE")  // "SALE" | "RENT_LONG" | "GENERAL"

  name           String
  email          String?
  phone          String?
  message        String

  status         String   @default("new")    // "new" | "treated" | "converted" | "spam"
  source         String   @default("DETAIL") // "DETAIL" | "CONTACT" | "WHATSAPP"
  notes          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([propertySlug])
  @@index([createdAt])
}

// Founding team / advisors. Drives the "Notre équipe" section on /about
// and an editorial sign-off on the home page. Admin-managed so the
// founders can add a 4th conseiller or rotate roles without a deploy.
model TeamMember {
  id        Int    @id @default(autoincrement())
  slug      String @unique           // "abdou" | "simo" | "ahmed" — stable URL/anchor handle

  // Display fields
  name      String                   // "Abdou", "Simo", "Ahmed"
  // Per-locale role + bio. FR is the canonical fallback (matches the
  // pattern used on Property / Settings); EN / AR are optional and the
  // public component falls back to FR when missing.
  roleFr    String
  roleEn    String?
  roleAr    String?
  bioFr     String  @default("")
  bioEn     String?
  bioAr     String?

  // Optional photo URL — published on Cloudflare R2 via /api/admin/upload.
  // When null, the card renders an elegant monogram tile instead.
  photoUrl  String?

  // Direct-contact shortcuts. WhatsApp digits only (no leading +), email
  // and phone in their natural form. All optional so a teammate can opt
  // out of being a direct contact and still appear on /about.
  whatsapp  String?
  email     String?
  phone     String?

  // Listing-kind specialty. Lets the public team card flag the
  // person as "Spécialiste · Long durée / Court séjour / Achat" so
  // a visitor knows which conseiller to contact directly.
  // Stored as a plain string (SHORT_STAY | RENT_LONG | SALE) to mirror
  // the Property.listingKind column. NULL = no specialty (e.g. a
  // generalist founder or admin role).
  specialty String?

  // Visibility + ordering. Same pattern as Property: a `position` int
  // drives the public order, `published` lets the admin draft a new
  // member without surfacing them on the public site yet.
  position  Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
